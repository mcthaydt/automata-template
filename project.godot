[layer_names]

3d_physics/layer_6="vcam_occludable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/default_filters/use_nearest_mipmap_filter=true
textures/decals/filter=0
textures/light_projectors/filter=0
textures/canvas_textures_default_texture_filter=2

[state]

#Reduxstatestoresettings#ForRELEASEbuilds:Setdebug/*tofalseinexportpresettodisable:#-Actionhistorytracking(savesmemory)#-Debugoverlaytoggle(F3key)#-Debugloggingoutputdebug/enable_history=true
debug/history_size=1000
debug/enable_debug_overlay=true
debug/enable_color_grading_debug_overlay=true
