; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="automata template"
run/main_scene="uid://ccv3ylnj0qbnm"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/core/textures/tex_icon.svg"
boot_splash/minimum_display_time=5

[display]

window/size/viewport_width=960
window/size/viewport_height=600
window/size/resizable=false
window/stretch/mode="viewport"
window/handheld/orientation="sensor_landscape"
window/vsync/vsync_mode=0

[editor_plugins]

enabled=PackedStringArray("res://addons/IVX_VertexColorImportSwapper/plugin.cfg", "res://addons/gut/plugin.cfg")

[file_customization]

folder_colors={
"res://addons/": "gray",
"res://assets/": "green",
"res://assets/core/editor_icons/": "blue",
"res://docs/": "red",
"res://resources/": "blue",
"res://scenes/": "green",
"res://scenes/templates/": "green",
"res://scripts/": "blue",
"res://tests/": "red"
}

[gdscript]

warnings/assert_always_false=true
warnings/assert_always_true=true
warnings/confusable_identifier=true
warnings/confusable_local_declaration=true
warnings/confusable_local_usage=true
warnings/deprecated_keyword=true
warnings/get_node_default_without_onready=true
warnings/incompatible_ternary=true
warnings/inferred_declaration=false
warnings/int_as_enum_without_cast=true
warnings/int_as_enum_without_match=true
warnings/narrowing_conversion=true
warnings/native_method_override=false
warnings/onready_with_export=true
warnings/redundant_await=true
warnings/return_value_discarded=false
warnings/shadowed_global_identifier=true
warnings/shadowed_variable=true
warnings/shadowed_variable_base_class=true
warnings/standalone_expression=true
warnings/static_called_on_instance=true
warnings/unassigned_variable=true
warnings/unassigned_variable_op_assign=true
warnings/unreachable_code=true
warnings/unreachable_pattern=true
warnings/unsafe_call_argument=false
warnings/unsafe_cast=false
warnings/unsafe_method_access=false
warnings/unsafe_property_access=false
warnings/untyped_declaration=false
warnings/unused_local_constant=true
warnings/unused_parameter=true
warnings/unused_signal=true
warnings/unused_variable=true

